{
  "name": "tena-query-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run verify:files && bun run build:meta && next build",
    "build:meta": "bun scripts/generate-build-info.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "bun run build:meta && tsc --noEmit",
    "verify:files": "bun scripts/verify-required-files.ts",
    "test": "bun test",
    "test:unit": "bun test src/lib/server",
    "test:regression": "bun test tests/regression",
    "test:contract": "bun test tests/contracts",
    "test:integration": "bun test tests/integration",
    "quality": "bun scripts/run-quality-gate.ts",
    "smoke": "bun scripts/smoke-test.ts",
    "test:model": "bun scripts/actual-model-eval.ts",
    "test:e2e": "bun scripts/staging-e2e.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "mysql2": "^3.14.0",
    "next": "15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/bun": "^1.2.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.2.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "bun@1.2.14"
}
