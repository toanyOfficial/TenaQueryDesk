# Shared login (server-only)
APP_PASSWORD_HASH=
SESSION_SECRET=

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_MAX_RETRIES=1

# Management database (MySQL, server-only)
MANAGEMENT_DB_HOST=
MANAGEMENT_DB_PORT=3306
MANAGEMENT_DB_NAME=
MANAGEMENT_DB_USER=
MANAGEMENT_DB_PASSWORD=

# Encryption key for target database credentials (server-only, Base64-encoded 32 bytes)
DB_CREDENTIAL_ENCRYPTION_KEY=

# Query execution policy (server-only)
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_MS=10000
QUERY_MAX_SQL_LENGTH=100000
